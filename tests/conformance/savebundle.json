{
  "suite": "savebundle",
  "spec_version": 1,
  "generated_by": "tools/gen_conformance.py",
  "cases": [
    {
      "name": "roundtrip_all_files",
      "input": {
        "op": "roundtrip",
        "files": {
          "auto.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}",
          "quick.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}",
          "protagonist.txt": "base:protagonist/sakura",
          "goal.txt": "8200 8150\n"
        }
      },
      "expect": {
        "files": {
          "auto.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}",
          "quick.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}",
          "protagonist.txt": "base:protagonist/sakura",
          "goal.txt": "8200 8150\n"
        }
      }
    },
    {
      "name": "roundtrip_only_auto",
      "input": {
        "op": "roundtrip",
        "files": {
          "auto.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}"
        }
      },
      "expect": {
        "files": {
          "auto.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}"
        }
      }
    },
    {
      "name": "roundtrip_text_with_escapes",
      "input": {
        "op": "roundtrip",
        "files": {
          "auto.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}",
          "protagonist.txt": "café \"quoted\" \\ back\nline\ttab ☃"
        }
      },
      "expect": {
        "files": {
          "auto.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}",
          "protagonist.txt": "café \"quoted\" \\ back\nline\ttab ☃"
        }
      }
    },
    {
      "name": "roundtrip_drops_unknown_names",
      "input": {
        "op": "roundtrip",
        "files": {
          "auto.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}",
          "notes.txt": "not packed"
        }
      },
      "expect": {
        "files": {
          "auto.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}"
        }
      }
    },
    {
      "name": "import_valid",
      "input": {
        "op": "import",
        "text": "{\"aethersave\": 1, \"game_version\": \"0.0.1\", \"files\": {\"auto.json\": \"{\\\"save_version\\\": 1, \\\"seed\\\": \\\"0x00000000DEADBEEF\\\", \\\"map\\\": \\\"world\\\", \\\"player\\\": {\\\"hp\\\": 100, \\\"level\\\": 3}}\", \"protagonist.txt\": \"base:protagonist/ren\"}}"
      },
      "expect": {
        "files": {
          "auto.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}",
          "protagonist.txt": "base:protagonist/ren"
        }
      }
    },
    {
      "name": "import_valid_quick_only",
      "input": {
        "op": "import",
        "text": "{\"aethersave\": 1, \"game_version\": \"0.0.1\", \"files\": {\"quick.json\": \"{\\\"save_version\\\": 1, \\\"seed\\\": \\\"0x00000000DEADBEEF\\\", \\\"map\\\": \\\"world\\\", \\\"player\\\": {\\\"hp\\\": 100, \\\"level\\\": 3}}\"}}"
      },
      "expect": {
        "files": {
          "quick.json": "{\"save_version\": 1, \"seed\": \"0x00000000DEADBEEF\", \"map\": \"world\", \"player\": {\"hp\": 100, \"level\": 3}}"
        }
      }
    },
    {
      "name": "import_wrong_version",
      "input": {
        "op": "import",
        "text": "{\"aethersave\": 2, \"game_version\": \"0.0.1\", \"files\": {\"auto.json\": \"{\\\"save_version\\\": 1, \\\"seed\\\": \\\"0x00000000DEADBEEF\\\", \\\"map\\\": \\\"world\\\", \\\"player\\\": {\\\"hp\\\": 100, \\\"level\\\": 3}}\"}}"
      },
      "expect": {
