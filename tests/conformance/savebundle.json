      "input": {
        "op": "import",
        "text": "{\"aethersave\": \"1\", \"game_version\": \"0.0.1\", \"files\": {\"auto.json\": \"{\\\"save_version\\\": 1, \\\"seed\\\": \\\"0x00000000DEADBEEF\\\", \\\"map\\\": \\\"world\\\", \\\"player\\\": {\\\"hp\\\": 100, \\\"level\\\": 3}}\"}}"
      },
