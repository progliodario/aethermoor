    },
    {
      "name": "import_save_without_version",
      "input": {
        "op": "import",
        "text": "{\"aethersave\": 1, \"game_version\": \"0.0.1\", \"files\": {\"auto.json\": \"{\\\"seed\\\": \\\"0x1\\\"}\"}}"
