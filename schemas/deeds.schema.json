{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/deeds.schema.json",
  "title": "The deeds (spec 11, \"Deeds\"): facts about all the games, read from the profile",
  "type": "object",
  "required": [
    "id",
    "deeds"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:deeds/[a-z0-9_]+$"
    },
    "deeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "kind": {
            "enum": [
              "kills",
              "kinds",
              "titles",
              "lives",
              "defeated",
              "earned"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "enemies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "titles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "reward": {
            "description": "The gift every new game finds in its bag once the deed is done (spec 11, \"Gifts of the deeds\")",
            "type": "object",
            "required": [
              "item",
              "qty"
            ],
            "additionalProperties": false,
            "properties": {
              "item": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:item/[a-z0-9_]+$"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
