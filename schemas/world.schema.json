{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/world.schema.json",
  "title": "Procedural world parameters (docs/spec/09-worldgen.md)",
  "type": "object",
  "required": [
    "id",
    "width",
    "height",
    "border",
    "spawn_clear_radius",
    "elevation",
    "moisture",
    "temperature",
    "river",
    "road",
    "thresholds",
    "tiles",
    "props",
    "spawners",
    "time",
    "npcs"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
    },
    "width": {
      "type": "integer",
      "minimum": 32,
      "maximum": 65536
    },
    "height": {
      "type": "integer",
      "minimum": 32,
      "maximum": 65536
    },
    "border": {
      "type": "integer",
      "minimum": 0
    },
    "spawn_clear_radius": {
      "type": "integer",
      "minimum": 0
    },
    "elevation": {
      "type": "object",
      "required": [
        "salt",
        "scale",
        "octaves"
      ],
      "additionalProperties": false,
      "properties": {
        "salt": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "moisture": {
      "type": "object",
      "required": [
        "salt",
        "scale",
        "octaves"
      ],
      "additionalProperties": false,
      "properties": {
        "salt": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "temperature": {
      "type": "object",
      "required": [
        "salt",
        "scale",
        "octaves"
      ],
      "additionalProperties": false,
      "properties": {
        "salt": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "water",
        "beach",
        "mountain",
        "snow",
        "desert_heat",
        "desert_dry",
        "forest_wet"
      ],
      "properties": {
        "water": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "beach": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "mountain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "snow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "desert_heat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "desert_dry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "forest_wet": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "tiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "water",
        "beach",
        "desert",
        "snow",
        "mountain",
        "forest",
        "plains",
        "river",
        "ford",
        "road",
        "bridge"
      ],
      "properties": {
        "water": {
          "type": "integer",
          "minimum": 1
        },
        "beach": {
          "type": "integer",
          "minimum": 1
        },
        "desert": {
          "type": "integer",
          "minimum": 1
        },
        "snow": {
          "type": "integer",
          "minimum": 1
        },
        "mountain": {
          "type": "integer",
          "minimum": 1
        },
        "forest": {
          "type": "integer",
          "minimum": 1
        },
        "plains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "river": {
          "type": "integer",
          "minimum": 1
        },
        "ford": {
          "type": "integer",
          "minimum": 1
        },
        "road": {
          "type": "integer",
          "minimum": 1
        },
        "bridge": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "props": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "plains",
          "forest",
          "snow",
          "desert",
          "beach",
          "mountain"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "art",
            "radius_x100",
            "per_mille"
          ],
          "additionalProperties": false,
          "properties": {
            "art": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
            },
            "radius_x100": {
              "type": "integer",
              "minimum": 1
            },
            "per_mille": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        }
      }
    },
    "spawners": {
      "type": "object",
      "required": [
        "enemy",
        "biomes",
        "min_distance",
        "per_10000",
        "respawn_ticks"
      ],
      "additionalProperties": false,
      "properties": {
        "enemy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
        },
        "biomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_distance": {
          "type": "integer",
          "minimum": 0
        },
        "per_10000": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "respawn_ticks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "time": {
      "type": "object",
      "required": [
        "day_ticks",
        "start_tick",
        "light",
        "weather"
      ],
      "additionalProperties": false,
      "properties": {
        "day_ticks": {
          "type": "integer",
          "minimum": 1000
        },
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "light": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        },
        "weather": {
          "type": "object",
          "required": [
            "period_ticks",
            "fade_ticks",
            "kinds"
          ],
          "additionalProperties": false,
          "properties": {
            "period_ticks": {
              "type": "integer",
              "minimum": 1
            },
            "fade_ticks": {
              "type": "integer",
              "minimum": 1
            },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "weight",
                  "rain_pm",
                  "dim_pm"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rain_pm": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "dim_pm": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  }
                }
              }
            }
          }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "dialogue",
          "variant",
          "dx",
          "dy"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "dialogue": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
          },
          "variant": {
            "type": "string"
          },
          "dx": {
            "type": "integer"
          },
          "dy": {
            "type": "integer"
          }
        }
      }
    },
    "river": {
      "type": "object",
      "required": [
        "salt",
        "scale",
        "octaves",
        "half_width",
        "ford_salt",
        "ford_scale",
        "ford_min"
      ],
      "additionalProperties": false,
      "properties": {
        "salt": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "half_width": {
          "type": "integer",
          "minimum": 1
        },
        "ford_salt": {
          "type": "integer",
          "minimum": 0
        },
        "ford_scale": {
          "type": "integer",
          "minimum": 1
        },
        "ford_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "road": {
      "type": "object",
      "required": [
        "salt",
        "scale",
        "octaves",
        "half_width"
      ],
      "additionalProperties": false,
      "properties": {
        "salt": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "half_width": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
