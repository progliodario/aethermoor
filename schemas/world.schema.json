{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/world.schema.json",
  "title": "Procedural world parameters (docs/spec/09-worldgen.md)",
  "type": "object",
  "required": [
    "id",
    "width",
    "height",
    "border",
    "spawn_clear_radius",
    "elevation",
    "moisture",
    "temperature",
    "regions",
    "guild",
    "settlements",
    "river",
    "road",
    "thresholds",
    "tiles",
    "props",
    "spawners",
    "time",
    "npcs",
    "stones"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
    },
    "width": {
      "type": "integer",
      "minimum": 32,
      "maximum": 65536
    },
    "height": {
      "type": "integer",
      "minimum": 32,
      "maximum": 65536
    },
    "border": {
      "type": "integer",
      "minimum": 0
    },
    "region_blend": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16384
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enemy_hp_pct": {
          "type": "integer",
          "minimum": 10,
          "maximum": 2000
        },
        "enemy_atk_pct": {
          "type": "integer",
          "minimum": 10,
          "maximum": 2000
        }
      }
    },
    "landmark_clearing": {
      "type": "integer",
      "minimum": 0,
      "maximum": 96
    },
    "spawn_clear_radius": {
      "type": "integer",
      "minimum": 0
    },
    "elevation": {
      "type": "object",
      "required": [
        "salt",
        "scale",
        "octaves"
      ],
      "additionalProperties": false,
      "properties": {
        "salt": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "moisture": {
      "type": "object",
      "required": [
        "salt",
        "scale",
        "octaves"
      ],
      "additionalProperties": false,
      "properties": {
        "salt": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "temperature": {
      "type": "object",
      "required": [
        "salt",
        "scale",
        "octaves"
      ],
      "additionalProperties": false,
      "properties": {
        "salt": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "water",
        "beach",
        "mountain",
        "snow",
        "desert_heat",
        "desert_dry",
        "forest_wet"
      ],
      "properties": {
        "water": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "beach": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "mountain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "snow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "desert_heat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "desert_dry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "forest_wet": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "tiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "water",
        "beach",
        "desert",
        "snow",
        "mountain",
        "forest",
        "plains",
        "river",
        "ford",
        "road",
        "bridge"
      ],
      "properties": {
        "water": {
          "type": "integer",
          "minimum": 1
        },
        "beach": {
          "type": "integer",
          "minimum": 1
        },
        "desert": {
          "type": "integer",
          "minimum": 1
        },
        "snow": {
          "type": "integer",
          "minimum": 1
        },
        "mountain": {
          "type": "integer",
          "minimum": 1
        },
        "forest": {
          "type": "integer",
          "minimum": 1
        },
        "plains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "river": {
          "type": "integer",
          "minimum": 1
        },
        "ford": {
          "type": "integer",
          "minimum": 1
        },
        "road": {
          "type": "integer",
          "minimum": 1
        },
        "bridge": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "props": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "plains",
          "forest",
          "snow",
          "desert",
          "beach",
          "mountain"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "art",
            "radius_x100",
            "per_mille"
          ],
          "additionalProperties": false,
          "properties": {
            "art": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
            },
            "radius_x100": {
              "type": "integer",
              "minimum": 1
            },
            "per_mille": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        }
      }
    },
    "spawners": {
      "type": "object",
      "required": [
        "biomes",
        "min_distance",
        "per_10000",
        "respawn_ticks"
      ],
      "additionalProperties": false,
      "properties": {
        "biomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_distance": {
          "type": "integer",
          "minimum": 0
        },
        "per_10000": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "respawn_ticks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "time": {
      "type": "object",
      "required": [
        "day_ticks",
        "start_tick",
        "light",
        "weather"
      ],
      "additionalProperties": false,
      "properties": {
        "day_ticks": {
          "type": "integer",
          "minimum": 1000
        },
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "light": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        },
        "weather": {
          "type": "object",
          "required": [
            "period_ticks",
            "fade_ticks",
            "kinds"
          ],
          "additionalProperties": false,
          "properties": {
            "period_ticks": {
              "type": "integer",
              "minimum": 1
            },
            "fade_ticks": {
              "type": "integer",
              "minimum": 1
            },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "weight",
                  "rain_pm",
                  "dim_pm"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rain_pm": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "dim_pm": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  }
                }
              }
            },
            "rain_aggro_cut_pm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "description": "How much full rain shortens the distance at which creatures notice the player, in permille (spec 08, \"Rain hides you\")."
            }
          }
        },
        "seasons": {
          "type": "array",
          "minItems": 1,
          "description": "The seasons of the year in order (spec 08, Seasons).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "days",
              "tint"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "days": {
                "type": "integer",
                "minimum": 1
              },
              "tint": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "weights": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "light": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  }
                }
              }
            }
          }
        },
        "night_aggro_cut_pm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "How much full darkness (light 0) shortens the distance at which creatures notice the player, in permille (spec 08, \"The night hides you\")."
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "dialogue",
          "variant",
          "dx",
          "dy"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "dialogue": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
          },
          "variant": {
            "type": "string"
          },
          "dx": {
            "type": "integer"
          },
          "dy": {
            "type": "integer"
          }
        }
      }
    },
    "river": {
      "type": "object",
      "required": [
        "salt",
        "scale",
        "octaves",
        "half_width",
        "ford_salt",
        "ford_scale",
        "ford_min"
      ],
      "additionalProperties": false,
      "properties": {
        "salt": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "half_width": {
          "type": "integer",
          "minimum": 1
        },
        "ford_salt": {
          "type": "integer",
          "minimum": 0
        },
        "ford_scale": {
          "type": "integer",
          "minimum": 1
        },
        "ford_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "road": {
      "type": "object",
      "required": [
        "salt",
        "scale",
        "octaves",
        "half_width"
      ],
      "additionalProperties": false,
      "properties": {
        "salt": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "half_width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "x_pm",
          "y_pm",
          "danger",
          "tone",
          "fauna",
          "shop"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "x_pm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "y_pm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "danger": {
            "type": "integer",
            "minimum": 1
          },
          "tone": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "bias": {
            "type": "object",
            "additionalProperties": false,
            "description": "Added to the elevation, temperature and moisture fields near the center of the region (spec 09, Regions).",
            "properties": {
              "elevation": {
                "type": "integer",
                "minimum": -30000,
                "maximum": 30000
              },
              "temperature": {
                "type": "integer",
                "minimum": -30000,
                "maximum": 30000
              },
              "moisture": {
                "type": "integer",
                "minimum": -30000,
                "maximum": 30000
              }
            }
          },
          "ground": {
            "type": "object",
            "description": "Ground tile gids of the region by biome, instead of the ones of `tiles`.",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "props": {
            "type": "object",
            "description": "Random props of the region by biome, instead of the ones of `props`.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "art",
                  "radius_x100",
                  "per_mille"
                ],
                "additionalProperties": false,
                "properties": {
                  "art": {
                    "type": "string"
                  },
                  "radius_x100": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "per_mille": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                }
              }
            }
          },
          "shop": {
            "type": "object",
            "required": [
              "price_pm",
              "stock"
            ],
            "additionalProperties": false,
            "properties": {
              "price_pm": {
                "type": "integer",
                "minimum": 1
              },
              "renown_step_pm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "renown_max_pm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 900
              },
              "market_swing_pm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 500
              },
              "renown_stock": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "item",
                    "renown"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "item": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*:item/[a-z0-9_]+$"
                    },
                    "renown": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "stock": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
                }
              }
            }
          },
          "fauna": {
            "type": "array",
            "minItems": 1,
            "description": "The enemies of the spawners of the region, by weight (spec 09, Fauna).",
            "items": {
              "type": "object",
              "required": [
                "enemy",
                "drop",
                "weight"
              ],
              "additionalProperties": false,
              "properties": {
                "enemy": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
                },
                "drop": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
                },
                "weight": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "settlements": {
      "type": "object",
      "required": [
        "per_mille",
        "kinds",
        "names",
        "dialogue",
        "variants",
        "quirks",
        "people"
      ],
      "additionalProperties": false,
      "properties": {
        "per_mille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "weight",
              "stamps"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "weight": {
                "type": "integer",
                "minimum": 1
              },
              "stamps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
                }
              }
            }
          }
        },
        "names": {
          "type": "object",
          "required": [
            "start",
            "mid",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mid": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "end": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "dialogue": {
          "type": "string",
          "description": "Dialogue id of a settlement NPC, with {role} and {tone}."
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "quirks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "people": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "end": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "stamp_defs": {
      "type": "object",
      "description": "The stamps named by settlements.kinds, resolved by the loader (not written by hand).",
      "additionalProperties": {
        "type": "object"
      }
    },
    "home": {
      "type": "object",
      "required": [
        "radius",
        "stamp",
        "dx",
        "dy"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "radius": {
          "type": "integer",
          "minimum": 1
        },
        "stamp": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
        },
        "dx": {
          "type": "integer"
        },
        "dy": {
          "type": "integer"
        }
      }
    },
    "guild": {
      "type": "object",
      "required": [
        "offers_per_day",
        "ranks",
        "templates"
      ],
      "additionalProperties": false,
      "properties": {
        "offers_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "ranks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "points"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]+$"
              },
              "points": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "target",
              "count_min",
              "count_max",
              "gold_base",
              "gold_per",
              "xp_base",
              "xp_per",
              "points_base",
              "points_per"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "type": {
                "enum": [
                  "kill",
                  "collect"
                ]
              },
              "target": {
                "type": "string",
                "pattern": "^([a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+|\\$fauna|\\$drop)$"
              },
              "count_min": {
                "type": "integer",
                "minimum": 0
              },
              "count_max": {
                "type": "integer",
                "minimum": 0
              },
              "gold_base": {
                "type": "integer",
                "minimum": 0
              },
              "gold_per": {
                "type": "integer",
                "minimum": 0
              },
              "xp_base": {
                "type": "integer",
                "minimum": 0
              },
              "xp_per": {
                "type": "integer",
                "minimum": 0
              },
              "points_base": {
                "type": "integer",
                "minimum": 0
              },
              "points_per": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "stones": {
