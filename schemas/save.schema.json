{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/save.schema.json",
  "title": "Save file (docs/spec/12-save-format.md)",
  "type": "object",
  "required": [
    "save_version",
    "player",
    "rng",
    "enemies",
    "inventory",
    "story"
  ],
  "properties": {
    "save_version": {
      "type": "integer",
      "minimum": 1
    },
    "game_version": {
      "type": "string"
    },
    "data_format_version": {
      "type": "integer",
      "minimum": 1
    },
    "protagonist": {
      "type": "string"
    },
    "seed": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{1,16}$"
    },
    "map": {
      "enum": [
        "",
        "demo",
        "world"
      ]
    },
    "explored": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "world_ticks": {
      "type": "integer",
      "minimum": -1
    },
    "cleared_spawners": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "items": {
          "type": "integer"
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "facing",
        "facing_left",
        "moving",
        "clip_tick",
        "hp",
        "level",
        "xp",
        "deaths",
        "kills",
        "iframes",
        "cooldown",
        "phase",
        "phase_tick",
        "hit_set"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "facing": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "facing_left": {
          "type": "boolean"
        },
        "moving": {
          "type": "boolean"
        },
        "clip_tick": {
          "type": "integer",
          "minimum": 0
        },
        "hp": {
          "type": "integer"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "deaths": {
          "type": "integer",
          "minimum": 0
        },
        "kills": {
          "type": "integer",
          "minimum": 0
        },
        "iframes": {
          "type": "integer",
          "minimum": 0
        },
        "cooldown": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "none",
            "startup",
            "active",
            "recovery"
          ]
        },
        "phase_tick": {
          "type": "integer",
          "minimum": 0
        },
        "hit_set": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        }
      }
    },
    "rng": {
      "type": "object",
      "required": [
        "combat",
        "loot"
      ],
      "additionalProperties": false,
      "properties": {
        "combat": {
          "type": "object",
          "required": [
            "state",
            "inc"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{1,16}$"
            },
            "inc": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{1,16}$"
            }
          }
        },
        "loot": {
          "type": "object",
          "required": [
            "state",
            "inc"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{1,16}$"
            },
            "inc": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{1,16}$"
            }
          }
        }
      }
    },
    "enemies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "hp",
          "state",
          "state_tick"
        ],
        "properties": {
          "spawner": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer"
            }
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "hp": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "idle",
              "chase",
              "attack",
              "return",
              "dead"
            ]
          },
          "state_tick": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "story": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "flags",
        "gold",
        "quests",
        "dialogue"
      ],
      "properties": {
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "gold": {
          "type": "integer",
          "minimum": 0
        },
        "quests": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "progress",
              "done"
            ],
            "properties": {
              "stage": {
                "type": "string"
              },
              "progress": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "done": {
                "type": "boolean"
              },
              "day": {
                "description": "The day a timed quest was started (spec 07, \"Timed quests\")",
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "dialogue": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "node"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "node": {
              "type": "string"
            },
            "args": {
              "description": "The arguments of the person talking (spec 07), when it had some",
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "guild_points": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "equipped": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weapon": {
          "type": "string"
        },
        "armor": {
          "type": "string"
        },
        "accessory": {
          "type": "string"
        }
      }
    },
    "runes": { "description": "The runes engraved on the weapons, weapon item -> rune item (spec 06, \"Runes\")", "type": "object", "additionalProperties": { "type": "string" } },
    "rolls": { "description": "The percent the affix of a piece found was rolled at, item -> percent (spec 06, \"Rolled affixes\")", "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "furniture": {
      "description": "The furniture of the home, [x100, y100, item] in order (spec 06, \"Furniture\")",
      "type": "array",
      "items": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }, { "type": "string" }], "minItems": 3, "maxItems": 3 }
    },
    "tag": { "description": "The tag worn (spec 11, \"Tags\")", "type": "string" },
    "talents": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "chest": { "description": "What the chests hold, shared by all of them (spec 06, \"Chests\")", "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "counters": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "bestiary": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "companion": {
      "type": "object",
      "required": ["x", "y", "cooldown"],
      "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "cooldown": { "type": "integer", "minimum": 0 }, "stay": { "type": "boolean" }, "bond": { "type": "integer", "minimum": 0 }, "id": { "type": "string" } }
    },
    "party": {
      "description": "the companions of the party, the protagonist's first (spec 10, \"The party\"); absent while it is the one of the start",
      "type": "array",
      "items": { "type": "string" }
    },
    "bonds": {
      "description": "the bonds of the companions of the party that wait (spec 10, \"The party\")",
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "plots": {
      "type": "array",
      "items": { "type": "array", "minItems": 4, "maxItems": 4 }
    },
    "friend": {
      "type": "object",
      "required": ["enemy", "x", "y", "cooldown"],
      "additionalProperties": false,
      "properties": { "enemy": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "cooldown": { "type": "integer", "minimum": 0 }, "stay": { "type": "boolean" } }
    },
    "stones": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Tiles [x, y] of the Threshold Stones that were used, in order (spec 09)."
    }
  }
}
