{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/save.schema.json",
  "title": "Save file (docs/spec/12-save-format.md)",
  "type": "object",
  "required": [
    "save_version",
    "player",
    "rng",
    "enemies",
    "inventory",
    "story"
  ],
  "properties": {
    "save_version": {
      "type": "integer",
      "minimum": 1
    },
    "game_version": {
      "type": "string"
    },
    "data_format_version": {
      "type": "integer",
      "minimum": 1
    },
    "protagonist": {
      "type": "string"
    },
    "seed": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{1,16}$"
    },
    "map": {
      "enum": [
        "",
        "demo",
        "world"
      ]
    },
    "cleared_spawners": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer"
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "facing",
        "facing_left",
        "moving",
        "clip_tick",
        "hp",
        "level",
        "xp",
        "deaths",
        "kills",
        "iframes",
        "cooldown",
        "phase",
        "phase_tick",
        "hit_set"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "facing": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "facing_left": {
          "type": "boolean"
        },
        "moving": {
          "type": "boolean"
        },
        "clip_tick": {
          "type": "integer",
          "minimum": 0
        },
        "hp": {
          "type": "integer"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "deaths": {
          "type": "integer",
          "minimum": 0
        },
        "kills": {
          "type": "integer",
          "minimum": 0
        },
        "iframes": {
          "type": "integer",
          "minimum": 0
        },
        "cooldown": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "none",
            "startup",
            "active",
            "recovery"
          ]
        },
        "phase_tick": {
          "type": "integer",
          "minimum": 0
        },
        "hit_set": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        }
      }
    },
    "rng": {
      "type": "object",
      "required": [
        "combat",
        "loot"
      ],
      "additionalProperties": false,
      "properties": {
        "combat": {
          "type": "object",
          "required": [
            "state",
            "inc"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{1,16}$"
            },
            "inc": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{1,16}$"
            }
          }
        },
        "loot": {
          "type": "object",
          "required": [
            "state",
            "inc"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{1,16}$"
            },
            "inc": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{1,16}$"
            }
          }
        }
      }
    },
    "enemies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "hp",
          "state",
          "state_tick"
        ],
        "properties": {
          "spawner": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer"
            }
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "hp": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "idle",
              "chase",
              "attack",
              "return",
              "dead"
            ]
          },
          "state_tick": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "story": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "flags",
        "gold",
        "quests",
        "dialogue"
      ],
      "properties": {
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "gold": {
          "type": "integer",
          "minimum": 0
        },
        "quests": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "progress",
              "done"
            ],
            "properties": {
              "stage": {
                "type": "string"
              },
              "progress": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "done": {
                "type": "boolean"
              }
            }
          }
        },
        "dialogue": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "node"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "node": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
