{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/art_recipe.schema.json",
  "title": "Vector art recipe",
  "type": "object",
  "required": ["id", "canvas", "layers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/id" },
    "canvas": {
      "type": "object",
      "required": ["w", "h", "origin"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "origin": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
      }
    },
    "palette": { "$ref": "#/$defs/palette" },
    "variants": { "type": "object", "additionalProperties": { "$ref": "#/$defs/palette" } },
    "layers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layer" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$" },
    "color": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$p\\.[a-z0-9_]+)$" },
    "palette": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_]+$" },
      "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" }
    },
    "number4": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "stops": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "$ref": "#/$defs/color" }],
        "items": false,
        "minItems": 2
      }
    },
    "shape": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "rect": { "$ref": "#/$defs/number4" },
        "ellipse": { "$ref": "#/$defs/number4" },
        "polygon": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        },
        "path": { "type": "string", "pattern": "^[MLHVCQZ0-9eE.,+\\- ]+$" }
      }
    },
    "fill": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "linear": {
          "type": "object",
          "required": ["x0", "y0", "x1", "y1", "stops"],
          "additionalProperties": false,
          "properties": {
            "x0": { "type": "number" }, "y0": { "type": "number" },
            "x1": { "type": "number" }, "y1": { "type": "number" },
            "stops": { "$ref": "#/$defs/stops" }
          }
        },
        "radial": {
          "type": "object",
          "required": ["cx", "cy", "r", "stops"],
          "additionalProperties": false,
          "properties": {
            "cx": { "type": "number" }, "cy": { "type": "number" },
            "r": { "type": "number", "exclusiveMinimum": 0 },
            "stops": { "$ref": "#/$defs/stops" }
          }
        }
      }
    },
    "stroke": {
      "type": "object",
      "required": ["color", "width"],
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "width": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "layer": {
      "type": "object",
      "required": ["shape"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "shape": { "$ref": "#/$defs/shape" },
        "fill": { "$ref": "#/$defs/fill" },
        "stroke": { "$ref": "#/$defs/stroke" },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
