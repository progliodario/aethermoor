{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/talents.schema.json",
  "title": "Talents the player learns with the points of the levels (spec 11)",
  "type": "object",
  "required": [
    "id",
    "points_per_level",
    "talents"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:talents/[a-z0-9_]+$"
    },
    "points_per_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "talents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "stat",
          "pct_per_rank",
          "max_rank"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "stat": {
            "enum": [
              "attack",
              "health",
              "mana",
              "defense",
              "magic",
              "critical",
              "speed",
              "riposte",
              "kill_heal",
              "kill_mana",
              "whirl",
              "burst",
              "mend"
            ]
          },
          "pct_per_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "max_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "active": {
            "type": "object",
            "required": [
              "mp",
              "cooldown_ticks"
            ],
            "additionalProperties": false,
            "properties": {
              "mp": {
                "type": "integer",
                "minimum": 0
              },
              "cooldown_ticks": {
                "type": "integer",
                "minimum": 1
              },
              "radius_x100": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "requires": {
            "type": "object",
            "required": [
              "talent",
              "rank"
            ],
            "additionalProperties": false,
            "properties": {
              "talent": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
