{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/gathering.schema.json",
  "title": "Which props of the world can be gathered from, and what they give",
  "type": "object",
  "required": ["id", "nodes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:gathering/[a-z0-9_]+$" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prop", "sound", "cooldown_ticks", "reach_x100", "drops"],
        "additionalProperties": false,
        "properties": {
          "prop": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:art/prop/[a-z0-9_]+$" },
          "sound": { "enum": ["plant", "wood", "stone", "water"] },
          "cooldown_ticks": { "type": "integer", "minimum": 1 },
          "reach_x100": { "type": "integer", "minimum": 50, "maximum": 400 },
          "drops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["item", "qty_min", "qty_max", "weight_pm"],
              "additionalProperties": false,
              "properties": {
                "item": { "type": "string" },
                "qty_min": { "type": "integer", "minimum": 1 },
                "qty_max": { "type": "integer", "minimum": 1 },
                "weight_pm": { "type": "integer", "minimum": 1, "maximum": 1000 }
              }
            }
          }
        }
      }
    }
  }
}
