{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/lights.schema.json",
  "title": "The props that shine at night (spec 08, \"Lights\")",
  "type": "object",
  "required": [
    "id",
    "lights"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:lights/[a-z0-9_]+$"
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "art",
          "radius_x100",
          "color",
          "strength_pm"
        ],
        "additionalProperties": false,
        "properties": {
          "art": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:art/prop/[a-z0-9_]+$"
          },
          "radius_x100": {
            "type": "integer",
            "minimum": 50,
            "maximum": 1500
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "strength_pm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "flicker_pm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        }
      }
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "description": "The colour of the hour (spec 08): art direction, presentation only.",
      "properties": {
        "night": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "What the screen is multiplied by at full night."
        },
        "twilight": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "What the screen is multiplied by at dawn and dusk."
        },
        "vignette_pm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "How dark the edges of the screen are."
        },
        "motes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "How many motes drift over the world."
        },
        "mote_day": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "The colour of the motes in daylight (dust in the sun)."
        },
        "mote_night": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "The colour of the motes at night (fireflies)."
        },
        "snow_regions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "The regions (by id) where the rain falls as snow."
        },
        "shadow_pm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "How dark the long shadows of dawn and dusk are."
        }
      }
    }
  }
}
