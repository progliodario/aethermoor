{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/rig.schema.json",
  "title": "Animation rig",
  "type": "object",
  "required": [
    "id",
    "parts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "parent",
          "offset",
          "z",
          "art"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "offset": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "z": {
            "type": "integer"
          },
          "art": {
            "$ref": "#/$defs/id"
          },
          "art_back": {
            "$ref": "#/$defs/id",
            "description": "The recipe of the part when the figure is seen from behind (default: `art`)."
          },
          "z_back": {
            "type": "integer",
            "description": "The draw order of the part when the figure is seen from behind (default: `z`)."
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
    }
  }
}
