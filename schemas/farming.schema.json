{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/farming.schema.json",
  "title": "The plots and the crops (spec 06, \"Farming\")",
  "type": "object",
  "required": [
    "id",
    "plot",
    "reach_x100",
    "crops"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:farming/[a-z0-9_]+$"
    },
    "plot": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:art/prop/[a-z0-9_]+$"
    },
    "reach_x100": {
      "type": "integer",
      "minimum": 1
    },
    "crops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "seed",
          "crop",
          "qty_min",
          "qty_max",
          "grow_ticks"
        ],
        "additionalProperties": false,
        "properties": {
          "seed": {
            "type": "string"
          },
          "crop": {
            "type": "string"
          },
          "qty_min": {
            "type": "integer",
            "minimum": 1
          },
          "qty_max": {
            "type": "integer",
            "minimum": 1
          },
          "grow_ticks": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "rain_grow_cut_pm": {
      "description": "How much full rain shortens the growing of a seed sown in it, in permille (spec 06, \"Rain on the plots\")",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "season_grow_pm": {
      "description": "How long a seed sown in each season takes to grow, in permille of its time; a season not listed: 1000 (spec 06, \"Seasons on the plots\")",
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
