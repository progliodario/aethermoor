{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/sfx_recipe.schema.json",
  "title": "Sound effect recipe",
  "type": "object",
  "required": ["id", "duration_ms", "volume_pm", "layers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:audio/sfx/[a-z0-9_]+$" },
    "duration_ms": { "type": "integer", "minimum": 1, "maximum": 12000 },
    "volume_pm": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "loop": { "type": "boolean" },
    "layers": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/layer" } }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "required": ["wave", "freq_start", "freq_end", "volume_pm", "attack_ms", "decay_ms"],
      "additionalProperties": false,
      "properties": {
        "wave": { "enum": ["sine", "square", "saw", "triangle", "noise"] },
        "freq_start": { "type": "integer", "minimum": 20, "maximum": 10000 },
        "freq_end": { "type": "integer", "minimum": 20, "maximum": 10000 },
        "volume_pm": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "duty_pm": { "type": "integer", "minimum": 50, "maximum": 950 },
        "attack_ms": { "type": "integer", "minimum": 0, "maximum": 4000 },
        "decay_ms": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "am_dhz": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "am_depth_pm": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    }
  }
}
