{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/recipes.schema.json",
  "title": "Crafting recipes",
  "type": "object",
  "required": [
    "id",
    "recipes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:recipes/[a-z0-9_]+$"
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "output",
          "inputs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "output": {
            "type": "object",
            "required": [
              "item",
              "qty"
            ],
            "additionalProperties": false,
            "properties": {
              "item": {
                "type": "string"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "item",
                "qty"
              ],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "station": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:art/prop/[a-z0-9_]+$"
          }
        }
      }
    }
  }
}
