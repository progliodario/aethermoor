{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/clip.schema.json",
  "title": "Animation clip",
  "type": "object",
  "required": ["id", "rig", "loop", "length_ticks", "tracks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/id" },
    "rig": { "$ref": "#/$defs/id" },
    "loop": { "type": "boolean" },
    "length_ticks": { "type": "integer", "minimum": 1 },
    "tracks": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rot": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          },
          "pos": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tick", "event"],
        "additionalProperties": false,
        "properties": { "tick": { "type": "integer", "minimum": 0 }, "event": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$" }
  }
}
