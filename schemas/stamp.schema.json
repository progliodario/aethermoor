{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/stamp.schema.json",
  "title": "Settlement stamp (docs/spec/09-worldgen.md, \"Settlements\")",
  "type": "object",
  "required": [
    "id",
    "w",
    "h",
    "anchor",
    "rows",
    "legend"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
    },
    "w": {
      "type": "integer",
      "minimum": 1,
      "maximum": 48
    },
    "h": {
      "type": "integer",
      "minimum": 1,
      "maximum": 48
    },
    "anchor": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "legend": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tile": {
            "type": "integer",
            "minimum": 1
          },
          "prop": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
          },
          "radius_x100": {
            "type": "integer",
            "minimum": 1
          },
          "npc": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "spots": {
      "type": "array",
      "description": "Plaza tiles [x, y] (relative to the stamp) where people gather in the evening (spec 08, Routines).",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
