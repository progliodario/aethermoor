{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/project.schema.json",
  "title": "Project metadata",
  "type": "object",
  "required": ["name", "version", "application_id", "data_format_version", "save_version", "spec_version", "supported_features"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "name_is_provisional": { "type": "boolean" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "application_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "data_format_version": { "type": "integer", "minimum": 1 },
    "save_version": { "type": "integer", "minimum": 1 },
    "spec_version": { "type": "integer", "minimum": 1 },
    "supported_features": { "type": "array", "items": { "type": "string" } }
  }
}
