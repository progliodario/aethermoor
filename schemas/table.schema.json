{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/table.schema.json",
  "title": "Numeric table",
  "type": "object",
  "required": ["id", "kind", "start_level", "values"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:table/[a-z0-9_]+$" },
    "kind": { "const": "int_list" },
    "start_level": { "type": "integer", "minimum": 0 },
    "generated_by": { "type": "string" },
    "values": { "type": "array", "minItems": 1, "items": { "type": "integer" } }
  }
}
