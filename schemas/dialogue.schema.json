{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/dialogue.schema.json",
  "title": "Dialogue graph",
  "type": "object",
  "required": ["id", "start", "nodes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/id" },
    "start": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$" },
    "i18n_ref": { "type": "string", "pattern": "^\\$i18n:[a-z0-9_]+(\\.[a-z0-9_]+)*$" },
    "node_name": { "type": "string", "pattern": "^([a-z][a-z0-9_]*|end)$" },
    "node": {
      "oneOf": [
        { "type": "object", "required": ["type", "speaker", "text", "next"], "additionalProperties": false,
          "properties": { "type": { "const": "say" }, "speaker": { "type": "string" },
                          "expression": { "type": "string" }, "text": { "$ref": "#/$defs/i18n_ref" },
                          "next": { "$ref": "#/$defs/node_name" } } },
        { "type": "object", "required": ["type", "choices"], "additionalProperties": false,
          "properties": { "type": { "const": "choice" },
                          "choices": { "type": "array", "minItems": 1, "items": {
                            "type": "object", "required": ["text", "next"], "additionalProperties": false,
                            "properties": { "text": { "$ref": "#/$defs/i18n_ref" },
                                            "next": { "$ref": "#/$defs/node_name" } } } } } },
        { "type": "object", "required": ["type", "flag", "value", "next"], "additionalProperties": false,
          "properties": { "type": { "const": "set_flag" }, "flag": { "type": "string" },
                          "value": { "type": "boolean" }, "next": { "$ref": "#/$defs/node_name" } } }
      ]
    }
  }
}
