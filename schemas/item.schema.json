{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethermoor.invalid/schemas/item.schema.json",
  "title": "Item",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "kind",
    "rarity",
    "price"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "$ref": "#/$defs/i18n_ref"
    },
    "description": {
      "$ref": "#/$defs/i18n_ref"
    },
    "kind": {
      "enum": [
        "weapon",
        "armor",
        "accessory",
        "consumable",
        "material",
        "key",
        "food",
        "seed",
        "rune",
        "furniture",
        "temper",
        "reforge"
      ]
    },
    "rarity": {
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary",
        "mythic"
      ]
    },
    "price": {
      "type": "integer",
      "minimum": 0
    },
    "stack_max": {
      "type": "integer",
      "minimum": 1
    },
    "weapon": {
      "type": "object",
      "required": [
        "atk",
        "matk"
      ],
      "additionalProperties": false,
      "properties": {
        "atk": {
          "type": "integer",
          "minimum": 0
        },
        "matk": {
          "type": "integer",
          "minimum": 0
        },
        "element": {
          "enum": [
            "none",
            "fire",
            "water",
            "wind",
            "earth",
            "light",
            "dark"
          ]
        }
      }
    },
    "use": {
      "type": "object",
      "required": [
        "effects"
      ],
      "additionalProperties": false,
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "effect"
            ],
            "properties": {
              "effect": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "reforge": {
      "type": "object",
      "additionalProperties": false,
      "description": "changes the affix of a worn piece of a family (spec 06, \"Choosing an affix\"): next to its station, the worn piece becomes one of three others of its family, chosen by the player",
      "properties": {
        "station": { "type": "string" }
      }
    },
    "affix_family": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "the family of an affixed piece (spec 06, \"Choosing an affix\"): the pieces of a family are the same piece with another affix"
    },
    "temper": {
      "type": "object",
      "additionalProperties": false,
      "description": "tempers the affix of a worn piece (spec 06, \"Tempering\"): used from the bag next to its station, it rolls the affix again and keeps the better roll",
      "properties": {
        "station": { "type": "string" }
      }
    },
    "rune": {
      "type": "object",
      "additionalProperties": false,
      "description": "a rune (spec 06, \"Runes\"): used from the bag, it is engraved on the worn weapon",
      "properties": {
        "element": {
          "description": "the element the weapon hits with; none keeps its own",
          "enum": [
            "none",
            "fire",
            "water",
            "wind",
            "earth",
            "light",
            "dark"
          ]
        },
        "atk": {
          "description": "added to the attack of the weapon",
          "type": "integer",
          "minimum": 0
        },
        "matk": {
          "description": "added to the magic attack of the weapon",
          "type": "integer",
          "minimum": 0
        },
        "station": {
          "description": "the prop it is engraved next to; absent: anywhere",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:art/prop/[a-z0-9_]+$"
        }
      }
    },
    "furniture": {
      "type": "object",
      "required": [
        "art"
      ],
      "additionalProperties": false,
      "description": "a piece of furniture (spec 06, \"Furniture\"): used from the bag next to a spot of the home, it stands there and adds like a title",
      "properties": {
        "art": {
          "description": "the prop it is drawn as",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:art/prop/[a-z0-9_]+$"
        },
        "atk_pct": {
          "type": "integer",
          "minimum": 0,
          "description": "percent added to the attack of the hits"
        },
        "gather_bonus": {
          "type": "integer",
          "minimum": 0,
          "description": "more of every drop gathered"
        },
        "craft_bonus": {
          "type": "integer",
          "minimum": 0,
          "description": "more of the output of every recipe"
        },
        "parry_bonus": {
          "type": "integer",
          "minimum": 0,
          "description": "ticks added to the parry window"
        },
        "xp_pct": {
          "type": "integer",
          "minimum": 0,
          "description": "percent more experience from a kill"
        },
        "fine_pm": {
          "type": "integer",
          "minimum": 0,
          "description": "permille added to the chance of a fine piece"
        }
      }
    },
    "armor": {
      "type": "object",
      "required": [
        "def",
        "mdef"
      ],
      "additionalProperties": false,
      "properties": {
        "def": {
          "type": "integer",
          "minimum": 0
        },
        "mdef": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "accessory": {
      "type": "object",
      "additionalProperties": false,
      "description": "an accessory (spec 06, \"Equipment\"): flat bonuses added to the derived stats while it is worn",
      "properties": {
        "atk": {
          "type": "integer",
          "minimum": 0
        },
        "matk": {
          "type": "integer",
          "minimum": 0
        },
        "def": {
          "type": "integer",
          "minimum": 0
        },
        "mdef": {
          "type": "integer",
          "minimum": 0
        },
        "max_hp": {
          "type": "integer",
          "minimum": 0
        },
        "crit_pm": {
          "type": "integer",
          "minimum": 0
        },
        "drain_pm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "affix_roll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_pct", "max_pct"],
      "description": "how strong the affix comes out when the piece is found on a creature (spec 06, \"Rolled affixes\"): a percent drawn from min_pct to max_pct",
      "properties": {
        "min_pct": { "type": "integer", "minimum": 1 },
        "max_pct": { "type": "integer", "minimum": 1 }
      }
    },
    "affix": {
      "type": "object",
      "additionalProperties": false,
      "description": "an affix (spec 06, \"Affixes\"): flat bonuses of a weapon or an armor, added to the derived stats while it is worn, like an accessory's",
      "properties": {
        "atk": {
          "type": "integer",
          "minimum": 0
        },
        "matk": {
          "type": "integer",
          "minimum": 0
        },
        "def": {
          "type": "integer",
          "minimum": 0
        },
        "mdef": {
          "type": "integer",
          "minimum": 0
        },
        "max_hp": {
          "type": "integer",
          "minimum": 0
        },
        "crit_pm": {
          "type": "integer",
          "minimum": 0
        },
        "drain_pm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(/[a-z0-9_]+)+$"
    },
    "i18n_ref": {
      "type": "string",
      "pattern": "^\\$i18n:[a-z0-9_]+(\\.[a-z0-9_]+)*$"
    }
  }
}
