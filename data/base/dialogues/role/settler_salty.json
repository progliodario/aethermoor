{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/settler_salty",
  "start": "start",
  "nodes": {
    "start": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.settler.salty.hello",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.settler.why",
          "next": "why"
        },
        {
          "text": "$i18n:dlg.role.settler.soup",
          "next": "rest"
        },
        {
          "text": "$i18n:dlg.role.settler.bye",
          "next": "end"
        }
      ]
    },
    "why": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.settler.salty.why",
      "next": "menu"
    },
    "rest": {
      "type": "effects",
      "effects": [
        {
          "effect": "heal_full"
        }
      ],
      "next": "soup"
    },
    "soup": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.settler.salty.soup",
      "next": "end"
    }
  }
}
