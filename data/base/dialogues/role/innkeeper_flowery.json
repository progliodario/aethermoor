{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/innkeeper_flowery",
  "start": "start",
  "nodes": {
    "start": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.innkeeper.flowery.hello",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.feast.ask",
          "when": {
            "day_mod": {
              "every": 8,
              "at": 5
            }
          },
          "next": "feast"
        },
        {
          "text": "$i18n:dlg.role.friend_bed",
          "when": {
            "renown_at_least": 5
          },
          "next": "friend_bed"
        },
        {
          "text": "$i18n:dlg.role.pantry.ask",
          "when": {
            "not": {
              "any": [
                {
                  "quest_active": "base:quest/side/pantry_amber"
                },
                {
                  "quest_done": "base:quest/side/pantry_amber"
                }
              ]
            }
          },
          "next": "pantry_offer"
        },
        {
          "text": "$i18n:dlg.role.pantry.status",
          "when": {
            "quest_active": "base:quest/side/pantry_amber"
          },
          "next": "pantry_busy"
        },
        {
          "text": "$i18n:dlg.role.pantry.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/pantry_amber"
              },
              {
                "not": {
                  "flag": "pantry_pantry_amber_paid"
                }
              }
            ]
          },
          "next": "pantry_paid"
        },
        {
          "text": "$i18n:dlg.role.rumor",
          "next": "rumor"
        },
        {
          "text": "$i18n:dlg.role.legend",
          "next": "legend"
        },
        {
          "text": "$i18n:dlg.inn.flowery.bed",
          "when": {
            "gold_at_least": 14
          },
          "next": "inn_rest"
        },
        {
          "text": "$i18n:dlg.inn.flowery.bed",
          "when": {
            "not": {
              "gold_at_least": 14
            }
          },
          "next": "inn_poor"
        },
        {
          "text": "$i18n:dlg.inn.flowery.meal",
          "when": {
            "gold_at_least": 30
          },
          "next": "inn_meal"
        },
        {
          "text": "$i18n:dlg.role.night",
          "when": {
            "tod_between": [
              800,
              250
            ]
          },
          "next": "night_tale"
        },
        {
          "text": "$i18n:dlg.role.bye",
          "next": "end"
        }
      ]
    },
    "rumor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.flowery.rumor",
      "next": "end"
    },
    "legend": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.flowery.legend",
      "next": "end"
    },
    "pantry_offer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.pantry.flowery.offer",
      "next": "pantry_choice"
    },
    "pantry_choice": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.errand.accept",
          "effects": [
            {
              "effect": "start_quest",
              "quest": "base:quest/side/pantry_amber"
            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.errand.later",
          "next": "end"
        }
      ]
    },
    "pantry_busy": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.pantry.flowery.busy",
      "next": "end"
    },
    "pantry_paid": {
      "type": "effects",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "pantry_pantry_amber_paid",
          "value": true
        },
        {
          "effect": "add_xp",
          "amount": 120
        },
        {
          "effect": "add_gold",
          "amount": 260
        },
        {
          "effect": "add_item",
          "item": "base:item/potion_medium",
          "qty": 1
        }
      ],
      "next": "pantry_thanks"
    },
    "pantry_thanks": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.pantry.flowery.thanks",
      "next": "end"
    },
    "inn_rest": {
      "type": "effects",
      "effects": [
        {
          "effect": "spend_gold",
          "amount": 14
        },
        {
          "effect": "heal_full"
        }
      ],
      "next": "inn_slept"
    },
    "inn_slept": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.inn.flowery.slept",
      "next": "end"
    },
    "inn_poor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.inn.flowery.poor",
      "next": "end"
    },
    "inn_meal": {
      "type": "effects",
      "effects": [
        {
          "effect": "spend_gold",
          "amount": 30
        },
        {
          "effect": "add_item",
          "item": "base:item/honey_cake",
          "qty": 3
        }
      ],
      "next": "inn_fed"
    },
    "inn_fed": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.inn.flowery.fed",
      "next": "end"
    },
    "night_tale": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.night.flowery",
      "next": "end"
    },
    "friend_bed": {
      "type": "effects",
      "effects": [
        {
          "effect": "heal_full"
        }
      ],
      "next": "friend_rested"
    },
    "friend_rested": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.innkeeper.flowery.known",
      "next": "end"
    },
    "feast": {
      "type": "effects",
      "effects": [
        {
          "effect": "heal_full"
        }
      ],
      "next": "feast_say"
    },
    "feast_say": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.flowery.feast",
      "next": "feast_gift_check"
    },
    "feast_gift_check": {
      "type": "condition",
      "when": {
        "flag": "feast_sunscar_gift"
      },
      "then": "feast_market",
      "else": "feast_gift"
    },
    "feast_gift": {
      "type": "effects",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "feast_sunscar_gift",
          "value": true
        },
        {
          "effect": "add_item",
          "item": "base:item/desert_nectar",
          "qty": 2
        }
      ],
      "next": "feast_gift_say"
    },
    "feast_gift_say": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.flowery.gift",
      "next": "feast_market"
    },
    "feast_market": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.flowery.market",
      "next": "feast_shop"
    },
    "feast_shop": {
      "type": "effects",
      "effects": [
        {
          "effect": "open_shop",
          "region": "sunscar",
          "markup_pct": 75
        }
      ],
      "next": "end"
    }
  }
}
