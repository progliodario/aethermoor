{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/innkeeper_flowery",
  "start": "start",
  "nodes": {
    "start": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.innkeeper.flowery.hello",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.pantry.ask",
          "when": {
            "not": {
              "any": [
                {
                  "quest_active": "base:quest/side/pantry_amber"
                },
                {
                  "quest_done": "base:quest/side/pantry_amber"
                }
              ]
            }
          },
          "next": "pantry_offer"
        },
        {
          "text": "$i18n:dlg.role.pantry.status",
          "when": {
            "quest_active": "base:quest/side/pantry_amber"
          },
          "next": "pantry_busy"
        },
        {
          "text": "$i18n:dlg.role.pantry.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/pantry_amber"
              },
              {
                "not": {
                  "flag": "pantry_pantry_amber_paid"
                }
              }
            ]
          },
          "next": "pantry_paid"
        },
        {
          "text": "$i18n:dlg.role.rumor",
          "next": "rumor"
        },
        {
          "text": "$i18n:dlg.role.legend",
          "next": "legend"
        },
        {
          "text": "$i18n:dlg.role.bye",
          "next": "end"
        }
      ]
    },
    "rumor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.flowery.rumor",
      "next": "end"
    },
    "legend": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.flowery.legend",
      "next": "end"
    },
    "pantry_offer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.pantry.flowery.offer",
      "next": "pantry_choice"
    },
    "pantry_choice": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.errand.accept",
          "effects": [
            {
              "effect": "start_quest",
              "quest": "base:quest/side/pantry_amber"
            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.errand.later",
          "next": "end"
        }
      ]
    },
    "pantry_busy": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.pantry.flowery.busy",
      "next": "end"
    },
    "pantry_paid": {
      "type": "effects",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "pantry_pantry_amber_paid",
          "value": true
        },
        {
          "effect": "add_xp",
          "amount": 120
        },
        {
          "effect": "add_gold",
          "amount": 260
        },
        {
          "effect": "add_item",
          "item": "base:item/potion_medium",
          "qty": 1
        }
      ],
      "next": "pantry_thanks"
    },
    "pantry_thanks": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.pantry.flowery.thanks",
      "next": "end"
    }
  }
}
