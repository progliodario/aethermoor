{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/shopkeeper_mystic",
  "start": "start",
  "nodes": {
    "start": {
      "type": "condition",
      "when": {
        "renown_at_least": 3
      },
      "then": "known",
      "else": "hello"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.wares",
          "next": "shop"
        },
        {
          "text": "$i18n:dlg.role.smith.ask",
          "when": {
            "gold_at_least": 60
          },
          "effects": [
            {
              "effect": "temper",
              "gold": 60
            }
          ],
          "next": "smith"
        },
        {
          "text": "$i18n:dlg.role.recipe.ask",
          "when": {
            "not": {
              "flag": "recipe_moonlit_tea"
            }
          },
          "next": "recipe_offer"
        },
        {
          "text": "$i18n:dlg.role.caravan",
          "next": "caravan"
        },
        {
          "text": "$i18n:dlg.role.craft.ask",
          "when": {
            "not": {
              "flag": "craft_wisp_mantle_done"
            }
          },
          "next": "craft_info"
        },
        {
          "text": "$i18n:dlg.role.rumor",
          "next": "rumor"
        },
        {
          "text": "$i18n:dlg.role.road",
          "next": "road"
        },
        {
          "text": "$i18n:dlg.role.bye",
          "next": "end"
        }
      ]
    },
    "shop": {
      "type": "effects",
      "effects": [
        {
          "effect": "open_shop"
        }
      ],
      "next": "end"
    },
    "rumor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.mystic.rumor",
      "next": "end"
    },
    "road": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.mystic.road",
      "next": "end"
    },
    "craft_info": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.craft.mystic.info",
      "next": "craft_menu"
    },
    "craft_menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.craft.make",
          "when": {
            "all": [
              {
                "has_item": {
                  "item": "base:item/shade_wisp",
                  "qty": 6
                }
              },
              {
                "has_item": {
                  "item": "base:item/dire_fang",
                  "qty": 3
                }
              }
            ]
          },
          "next": "craft_do"
        },
        {
          "text": "$i18n:dlg.role.craft.later",
          "next": "end"
        }
      ]
    },
    "craft_do": {
      "type": "effects",
      "effects": [
        {
          "effect": "remove_item",
          "item": "base:item/shade_wisp",
          "qty": 6
        },
        {
          "effect": "remove_item",
          "item": "base:item/dire_fang",
          "qty": 3
        },
        {
          "effect": "add_item",
          "item": "base:item/wisp_mantle",
          "qty": 1
        },
        {
          "effect": "set_flag",
          "flag": "craft_wisp_mantle_done",
          "value": true
        }
      ],
      "next": "craft_done"
    },
    "craft_done": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.craft.mystic.done",
      "next": "end"
    },
    "hello": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.shopkeeper.mystic.hello",
      "next": "menu"
    },
    "known": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.shopkeeper.mystic.known",
      "next": "menu"
    },
    "caravan": {
      "type": "effects",
      "effects": [
        {
          "effect": "open_shop",
          "region": "verdalis",
          "markup_pct": 125
        }
      ],
      "next": "end"
    },
    "recipe_offer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.recipe.mystic.offer",
      "next": "recipe_choice"
    },
    "recipe_choice": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.recipe.learn",
          "next": "recipe_pay"
        },
        {
          "text": "$i18n:dlg.role.recipe.later",
          "next": "end"
        }
      ]
    },
    "recipe_pay": {
      "type": "condition",
      "when": {
        "gold_at_least": 400
      },
      "then": "recipe_taught",
      "else": "recipe_poor"
    },
    "recipe_taught": {
      "type": "effects",
      "effects": [
        {
          "effect": "spend_gold",
          "amount": 400
        },
        {
          "effect": "set_flag",
          "flag": "recipe_moonlit_tea",
          "value": true
        }
      ],
      "next": "recipe_learned"
    },
    "recipe_learned": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.recipe.mystic.learned",
      "next": "end"
    },
    "recipe_poor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.recipe.mystic.poor",
      "next": "end"
    },
    "smith": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.smith.mystic.done",
      "next": "end"
    }
  }
}
