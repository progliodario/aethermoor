{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/settler_flowery",
  "start": "start",
  "nodes": {
    "start": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.settler.flowery.hello",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.settler.trade",
          "next": "trade"
        },
        {
          "text": "$i18n:dlg.role.settler.why",
          "next": "why"
        },
        {
          "text": "$i18n:dlg.role.settler.soup",
          "next": "rest"
        },
        {
          "text": "$i18n:dlg.role.settler.bye",
          "next": "end"
        }
      ]
    },
    "why": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.settler.flowery.why",
      "next": "menu"
    },
    "rest": {
      "type": "effects",
      "effects": [
        {
          "effect": "heal_full"
        }
      ],
      "next": "soup"
    },
    "soup": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.settler.flowery.soup",
      "next": "end"
    },
    "trade": {
      "type": "condition",
      "when": {
        "quest_done": "base:quest/side/settle_sunscar"
      },
      "then": "done",
      "else": "trade_say"
    },
    "trade_say": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.settler.flowery.trade",
      "next": "asked"
    },
    "asked": {
      "type": "condition",
      "when": {
        "quest_active": "base:quest/side/settle_sunscar"
      },
      "then": "busy",
      "else": "offer"
    },
    "offer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.settler.flowery.offer",
      "next": "offer_choice"
    },
    "offer_choice": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.settler.accept",
          "effects": [
            {
              "effect": "start_quest",
              "quest": "base:quest/side/settle_sunscar"
            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.settler.later",
          "next": "menu"
        }
      ]
    },
    "busy": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.settler.flowery.busy",
      "next": "end"
    },
    "done": {
      "type": "condition",
      "when": {
        "flag": "settle_sunscar_thanked"
      },
      "then": "workshop",
      "else": "thanks"
    },
    "thanks": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.settler.flowery.thanks",
      "next": "thanked"
    },
    "thanked": {
      "type": "effects",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "settle_sunscar_thanked",
          "value": true
        }
      ],
      "next": "workshop"
    },
    "workshop": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.settler.flowery.workshop",
      "next": "shop"
    },
    "shop": {
      "type": "effects",
      "effects": [
        {
          "effect": "open_shop",
          "region": "sunscar",
          "markup_pct": 90
        }
      ],
      "next": "end"
    }
  }
}
