{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/innkeeper_warm",
  "start": "start",
  "nodes": {
    "start": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.innkeeper.warm.hello",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.feast.ask",
          "when": {
            "day_mod": {
              "every": 8,
              "at": 0
            }
          },
          "next": "feast"
        },
        {
          "text": "$i18n:dlg.role.feast.games",
          "when": {
            "all": [
              {
                "day_mod": {
                  "every": 8,
                  "at": 0
                }
              },
              {
                "not": {
                  "any": [
                    {
                      "quest_active": "base:quest/side/feast_verdalis"
                    },
                    {
                      "quest_done": "base:quest/side/feast_verdalis"
                    }
                  ]
                }
              }
            ]
          },
          "next": "feast_games"
        },
        {
          "text": "$i18n:dlg.role.feast.games_status",
          "when": {
            "quest_active": "base:quest/side/feast_verdalis"
          },
          "next": "feast_games_busy"
        },
        {
          "text": "$i18n:dlg.role.friend_bed",
          "when": {
            "renown_at_least": 5
          },
          "next": "friend_bed"
        },
        {
          "text": "$i18n:dlg.role.pantry.ask",
          "when": {
            "not": {
              "any": [
                {
                  "quest_active": "base:quest/side/pantry_fangs"
                },
                {
                  "quest_done": "base:quest/side/pantry_fangs"
                }
              ]
            }
          },
          "next": "pantry_offer"
        },
        {
          "text": "$i18n:dlg.role.pantry.status",
          "when": {
            "quest_active": "base:quest/side/pantry_fangs"
          },
          "next": "pantry_busy"
        },
        {
          "text": "$i18n:dlg.role.pantry.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/pantry_fangs"
              },
              {
                "not": {
                  "flag": "pantry_pantry_fangs_paid"
                }
              }
            ]
          },
          "next": "pantry_paid"
        },
        {
          "text": "$i18n:dlg.role.rumor",
          "next": "rumor"
        },
        {
          "text": "$i18n:dlg.role.legend",
          "next": "legend"
        },
        {
          "text": "$i18n:dlg.inn.warm.bed",
          "when": {
            "gold_at_least": 8
          },
          "next": "inn_rest"
        },
        {
          "text": "$i18n:dlg.inn.warm.bed",
          "when": {
            "not": {
              "gold_at_least": 8
            }
          },
          "next": "inn_poor"
        },
        {
          "text": "$i18n:dlg.inn.warm.meal",
          "when": {
            "gold_at_least": 24
          },
          "next": "inn_meal"
        },
        {
          "text": "$i18n:dlg.role.night",
          "when": {
            "tod_between": [
              800,
              250
            ]
          },
          "next": "night_tale"
        },
        {
          "text": "$i18n:dlg.role.bye",
          "next": "end"
        }
      ]
    },
    "rumor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.warm.rumor",
      "next": "end"
    },
    "legend": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.warm.legend",
      "next": "end"
    },
    "pantry_offer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.pantry.warm.offer",
      "next": "pantry_choice"
    },
    "pantry_choice": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.errand.accept",
          "effects": [
            {
              "effect": "start_quest",
              "quest": "base:quest/side/pantry_fangs"
            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.errand.later",
          "next": "end"
        }
      ]
    },
    "pantry_busy": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.pantry.warm.busy",
      "next": "end"
    },
    "pantry_paid": {
      "type": "effects",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "pantry_pantry_fangs_paid",
          "value": true
        },
        {
          "effect": "add_xp",
          "amount": 40
        },
        {
          "effect": "add_gold",
          "amount": 100
        },
        {
          "effect": "add_item",
          "item": "base:item/potion_medium",
          "qty": 1
        }
      ],
      "next": "pantry_thanks"
    },
    "pantry_thanks": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.pantry.warm.thanks",
      "next": "end"
    },
    "inn_rest": {
      "type": "effects",
      "effects": [
        {
          "effect": "spend_gold",
          "amount": 8
        },
        {
          "effect": "heal_full"
        }
      ],
      "next": "inn_slept"
    },
    "inn_slept": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.inn.warm.slept",
      "next": "end"
    },
    "inn_poor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.inn.warm.poor",
      "next": "end"
    },
    "inn_meal": {
      "type": "effects",
      "effects": [
        {
          "effect": "spend_gold",
          "amount": 24
        },
        {
          "effect": "add_item",
          "item": "base:item/honey_cake",
          "qty": 3
        }
      ],
      "next": "inn_fed"
    },
    "inn_fed": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.inn.warm.fed",
      "next": "end"
    },
    "night_tale": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.night.warm",
      "next": "end"
    },
    "friend_bed": {
      "type": "effects",
      "effects": [
        {
          "effect": "heal_full"
        }
      ],
      "next": "friend_rested"
    },
    "friend_rested": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.innkeeper.warm.known",
      "next": "end"
    },
    "feast": {
      "type": "effects",
      "effects": [
        {
          "effect": "heal_full"
        }
      ],
      "next": "feast_say"
    },
    "feast_say": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.warm.feast",
      "next": "feast_season_0"
    },
    "feast_gift_check": {
      "type": "condition",
      "when": {
        "flag": "feast_verdalis_gift"
      },
      "then": "feast_market",
      "else": "feast_gift"
    },
    "feast_gift": {
      "type": "effects",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "feast_verdalis_gift",
          "value": true
        },
        {
          "effect": "add_item",
          "item": "base:item/grandmothers_pie",
          "qty": 2
        }
      ],
      "next": "feast_gift_say"
    },
    "feast_gift_say": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.warm.gift",
      "next": "feast_market"
    },
    "feast_market": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.warm.market",
      "next": "feast_shop"
    },
    "feast_shop": {
      "type": "effects",
      "effects": [
        {
          "effect": "open_shop",
          "region": "verdalis",
          "markup_pct": 75
        }
      ],
      "next": "end"
    },
    "feast_games": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.warm.games",
      "next": "feast_games_choice"
    },
    "feast_games_choice": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.feast.join",
          "effects": [
            {
              "effect": "start_quest",
              "quest": "base:quest/side/feast_verdalis"
            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.feast.not_now",
          "next": "menu"
        }
      ]
    },
    "feast_games_busy": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.warm.games_busy",
      "next": "end"
    },
    "feast_season_0": {
      "type": "condition",
      "when": {
        "season": "spring"
      },
      "then": "feast_in_spring",
      "else": "feast_season_1"
    },
    "feast_in_spring": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.season.spring",
      "next": "feast_gift_check"
    },
    "feast_season_1": {
      "type": "condition",
      "when": {
        "season": "summer"
      },
      "then": "feast_in_summer",
      "else": "feast_season_2"
    },
    "feast_in_summer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.season.summer",
      "next": "feast_gift_check"
    },
    "feast_season_2": {
      "type": "condition",
      "when": {
        "season": "autumn"
      },
      "then": "feast_in_autumn",
      "else": "feast_season_3"
    },
    "feast_in_autumn": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.season.autumn",
      "next": "feast_gift_check"
    },
    "feast_season_3": {
      "type": "condition",
      "when": {
        "season": "winter"
      },
      "then": "feast_in_winter",
      "else": "feast_gift_check"
    },
    "feast_in_winter": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.feast.season.winter",
      "next": "feast_gift_check"
    }
  }
}
