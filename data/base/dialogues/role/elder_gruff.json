{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/elder_gruff",
  "start": "start",
  "nodes": {
    "start": {
      "type": "condition",
      "when": {
        "renown_at_least": 3
      },
      "then": "known",
      "else": "hello"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.errand.ask",
          "when": {
            "not": {
              "any": [
                {
                  "quest_active": "base:quest/side/slate_toll"
                },
                {
                  "quest_done": "base:quest/side/slate_toll"
                }
              ]
            }
          },
          "next": "errand_offer"
        },
        {
          "text": "$i18n:dlg.role.errand.status",
          "when": {
            "quest_active": "base:quest/side/slate_toll"
          },
          "next": "errand_busy"
        },
        {
          "text": "$i18n:dlg.role.errand.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/slate_toll"
              },
              {
                "not": {
                  "flag": "errand_slate_toll_paid"
                }
              }
            ]
          },
          "next": "errand_paid"
        },
        {
          "text": "$i18n:dlg.role.hunt.ask",
          "when": {
            "all": [
              {
                "flag": "errand_slate_toll_paid"
              },
              {
                "not": {
                  "any": [
                    {
                      "quest_active": "base:quest/side/den_alpha"
                    },
                    {
                      "quest_done": "base:quest/side/den_alpha"
                    }
                  ]
                }
              }
            ]
          },
          "next": "hunt_offer"
        },
        {
          "text": "$i18n:dlg.role.hunt.status",
          "when": {
            "quest_active": "base:quest/side/den_alpha"
          },
          "next": "hunt_busy"
        },
        {
          "text": "$i18n:dlg.role.hunt.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/den_alpha"
              },
              {
                "not": {
                  "flag": "hunt_den_alpha_paid"
                }
              }
            ]
          },
          "next": "hunt_paid"
        },
        {
          "text": "$i18n:dlg.role.rumor",
          "next": "rumor"
        },
        {
          "text": "$i18n:dlg.role.seasonal.ask",
          "when": {
            "all": [
              {
                "season": "winter"
              },
              {
                "not": {
                  "any": [
                    {
                      "quest_active": "base:quest/side/season_winter_stores"
                    },
                    {
                      "quest_done": "base:quest/side/season_winter_stores"
                    }
                  ]
                }
              }
            ]
          },
          "next": "seasonal_offer"
        },
        {
          "text": "$i18n:dlg.role.seasonal.ask",
          "when": {
            "all": [
              {
                "not": {
                  "season": "winter"
                }
              },
              {
                "not": {
                  "any": [
                    {
                      "quest_active": "base:quest/side/season_winter_stores"
                    },
                    {
                      "quest_done": "base:quest/side/season_winter_stores"
                    }
                  ]
                }
              }
            ]
          },
          "next": "seasonal_wait"
        },
        {
          "text": "$i18n:dlg.role.seasonal.status",
          "when": {
            "quest_active": "base:quest/side/season_winter_stores"
          },
          "next": "seasonal_busy"
        },
        {
          "text": "$i18n:dlg.role.seasonal.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/season_winter_stores"
              },
              {
                "not": {
                  "flag": "season_winter_stores_paid"
                }
              }
            ]
          },
          "next": "seasonal_paid"
        },
        {
          "text": "$i18n:dlg.role.bye",
          "next": "end"
        }
      ]
    },
    "rumor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.gruff.rumor",
      "next": "end"
    },
    "errand_offer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.errand.gruff.offer",
      "next": "errand_choice"
    },
    "errand_choice": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.errand.accept",
          "effects": [
            {
              "effect": "start_quest",
              "quest": "base:quest/side/slate_toll"
            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.errand.later",
          "next": "end"
        }
      ]
    },
    "errand_busy": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.errand.gruff.busy",
      "next": "end"
    },
    "errand_paid": {
      "type": "effects",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "errand_slate_toll_paid",
          "value": true
        },
        {
          "effect": "add_xp",
          "amount": 200
        },
        {
          "effect": "add_gold",
          "amount": 400
        },
        {
          "effect": "add_item",
          "item": "base:item/potion_small",
          "qty": 3
        }
      ],
      "next": "errand_thanks"
    },
    "errand_thanks": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.errand.gruff.thanks",
      "next": "end"
    },
    "hunt_offer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.hunt.gruff.offer",
      "next": "hunt_choice"
    },
    "hunt_choice": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.errand.accept",
          "effects": [
            {
              "effect": "start_quest",
              "quest": "base:quest/side/den_alpha"
            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.errand.later",
          "next": "end"
        }
      ]
    },
    "hunt_busy": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.hunt.gruff.busy",
      "next": "end"
    },
    "hunt_paid": {
      "type": "effects",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "hunt_den_alpha_paid",
          "value": true
        },
        {
          "effect": "add_xp",
          "amount": 320
        },
        {
          "effect": "add_gold",
          "amount": 700
        },
        {
          "effect": "add_guild_points",
          "amount": 40
        },
        {
          "effect": "add_item",
          "item": "base:item/potion_large",
          "qty": 2
        }
      ],
      "next": "hunt_thanks"
    },
    "hunt_thanks": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.hunt.gruff.thanks",
      "next": "end"
    },
    "seasonal_offer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.seasonal.gruff.offer",
      "next": "seasonal_choice"
    },
    "seasonal_choice": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.errand.accept",
          "effects": [
            {
              "effect": "start_quest",
              "quest": "base:quest/side/season_winter_stores"
            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.errand.later",
          "next": "end"
        }
      ]
    },
    "seasonal_wait": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.seasonal.gruff.wait",
      "next": "end"
    },
    "seasonal_busy": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.seasonal.gruff.busy",
      "next": "end"
    },
    "seasonal_paid": {
      "type": "effects",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "season_winter_stores_paid",
          "value": true
        },
        {
          "effect": "add_xp",
          "amount": 300
        },
        {
          "effect": "add_gold",
          "amount": 600
        },
        {
          "effect": "add_item",
          "item": "base:item/potion_large",
          "qty": 2
        }
      ],
      "next": "seasonal_thanks"
    },
    "seasonal_thanks": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.seasonal.gruff.thanks",
      "next": "end"
    },
    "hello": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.elder.gruff.hello",
      "next": "menu"
    },
    "known": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.elder.gruff.known",
      "next": "menu"
    }
  }
}
