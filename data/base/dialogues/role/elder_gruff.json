{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/elder_gruff",
  "start": "start",
  "nodes": {
    "start": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.elder.gruff.hello",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.errand.ask",
          "when": {
            "not": {
              "any": [
                {
                  "quest_active": "base:quest/side/slate_toll"
                },
                {
                  "quest_done": "base:quest/side/slate_toll"
                }
              ]
            }
          },
          "next": "errand_offer"
        },
        {
          "text": "$i18n:dlg.role.errand.status",
          "when": {
            "quest_active": "base:quest/side/slate_toll"
          },
          "next": "errand_busy"
        },
        {
          "text": "$i18n:dlg.role.errand.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/slate_toll"
              },
              {
                "not": {
                  "flag": "errand_slate_toll_paid"
                }
              }
            ]
          },
          "next": "errand_paid"
        },
        {
          "text": "$i18n:dlg.role.rumor",
          "next": "rumor"
        },
        {
          "text": "$i18n:dlg.role.bye",
          "next": "end"
        }
      ]
    },
    "rumor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.gruff.rumor",
      "next": "end"
    },
    "errand_offer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.errand.gruff.offer",
      "next": "errand_choice"
    },
    "errand_choice": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.errand.accept",
          "effects": [
            {
              "effect": "start_quest",
              "quest": "base:quest/side/slate_toll"
            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.errand.later",
          "next": "end"
        }
      ]
    },
    "errand_busy": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.errand.gruff.busy",
      "next": "end"
    },
    "errand_paid": {
      "type": "effects",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "errand_slate_toll_paid",
          "value": true
        },
        {
          "effect": "add_xp",
          "amount": 200
        },
        {
          "effect": "add_gold",
          "amount": 400
        },
        {
          "effect": "add_item",
          "item": "base:item/potion_small",
          "qty": 3
        }
      ],
      "next": "errand_thanks"
    },
    "errand_thanks": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.errand.gruff.thanks",
      "next": "end"
    }
  }
}
