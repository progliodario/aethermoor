{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/elder_mystic",
  "start": "start",
  "nodes": {
    "start": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.elder.mystic.hello",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.errand.ask",
          "when": {
            "not": {
              "any": [
                {
                  "quest_active": "base:quest/side/lantern_wisps"
                },
                {
                  "quest_done": "base:quest/side/lantern_wisps"
                }
              ]
            }
          },
          "next": "errand_offer"
        },
        {
          "text": "$i18n:dlg.role.errand.status",
          "when": {
            "quest_active": "base:quest/side/lantern_wisps"
          },
          "next": "errand_busy"
        },
        {
          "text": "$i18n:dlg.role.errand.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/lantern_wisps"
              },
              {
                "not": {
                  "flag": "errand_lantern_wisps_paid"
                }
              }
            ]
          },
          "next": "errand_paid"
        },
        {
          "text": "$i18n:dlg.role.hunt.ask",
          "when": {
            "all": [
              {
                "flag": "errand_lantern_wisps_paid"
              },
              {
                "not": {
                  "any": [
                    {
                      "quest_active": "base:quest/side/silver_alpha"
                    },
                    {
                      "quest_done": "base:quest/side/silver_alpha"
                    }
                  ]
                }
              }
            ]
          },
          "next": "hunt_offer"
        },
        {
          "text": "$i18n:dlg.role.hunt.status",
          "when": {
            "quest_active": "base:quest/side/silver_alpha"
          },
          "next": "hunt_busy"
        },
        {
          "text": "$i18n:dlg.role.hunt.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/silver_alpha"
              },
              {
                "not": {
                  "flag": "hunt_silver_alpha_paid"
                }
              }
            ]
          },
          "next": "hunt_paid"
        },
        {
          "text": "$i18n:dlg.role.rumor",
          "next": "rumor"
        },
        {
          "text": "$i18n:dlg.role.seasonal.ask",
          "when": {
            "all": [
              {
                "season": "spring"
              },
              {
                "not": {
                  "any": [
                    {
                      "quest_active": "base:quest/side/season_wisp_bloom"
                    },
                    {
                      "quest_done": "base:quest/side/season_wisp_bloom"
                    }
                  ]
                }
              }
            ]
          },
          "next": "seasonal_offer"
        },
        {
          "text": "$i18n:dlg.role.seasonal.ask",
          "when": {
            "all": [
              {
                "not": {
                  "season": "spring"
                }
              },
              {
                "not": {
                  "any": [
                    {
                      "quest_active": "base:quest/side/season_wisp_bloom"
                    },
                    {
                      "quest_done": "base:quest/side/season_wisp_bloom"
                    }
                  ]
                }
              }
            ]
          },
          "next": "seasonal_wait"
        },
        {
          "text": "$i18n:dlg.role.seasonal.status",
          "when": {
            "quest_active": "base:quest/side/season_wisp_bloom"
          },
          "next": "seasonal_busy"
        },
        {
          "text": "$i18n:dlg.role.seasonal.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/season_wisp_bloom"
              },
              {
                "not": {
                  "flag": "season_wisp_bloom_paid"
                }
              }
            ]
          },
          "next": "seasonal_paid"
        },
        {
          "text": "$i18n:dlg.role.bye",
          "next": "end"
        }
      ]
    },
    "rumor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.mystic.rumor",
      "next": "end"
    },
    "errand_offer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.errand.mystic.offer",
      "next": "errand_choice"
