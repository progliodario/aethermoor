            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.errand.later",
          "next": "end"
        }
      ]
    },
    "hunt_busy": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.hunt.mystic.busy",
      "next": "end"
    },
    "hunt_paid": {
      "type": "effects",
      "effects": [
        {
