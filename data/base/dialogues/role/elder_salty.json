                "quest_done": "base:quest/side/tide_pearls"
              },
              {
                "not": {
                  "flag": "errand_tide_pearls_paid"
                }
              }
            ]
          },
          "next": "errand_paid"
        },
        {
          "text": "$i18n:dlg.role.hunt.ask",
