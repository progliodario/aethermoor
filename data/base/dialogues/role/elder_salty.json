{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/elder_salty",
  "start": "start",
  "nodes": {
    "start": {
      "type": "condition",
      "when": {
        "renown_at_least": 3
      },
      "then": "known",
      "else": "hello"
    },
