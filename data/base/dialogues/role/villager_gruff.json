{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/villager_gruff",
  "start": "start",
  "nodes": {
    "start": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.villager.gruff.hello",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.tale.ask",
          "when": {
            "not": {
              "any": [
                {
                  "quest_active": "base:quest/side/tale_ironspine_1"
                },
                {
                  "quest_done": "base:quest/side/tale_ironspine_1"
                }
              ]
            }
          },
          "next": "tale_offer_1"
        },
        {
          "text": "$i18n:dlg.role.tale.status",
          "when": {
            "quest_active": "base:quest/side/tale_ironspine_1"
          },
          "next": "tale_busy_1"
        },
        {
          "text": "$i18n:dlg.role.tale.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/tale_ironspine_1"
              },
              {
                "not": {
                  "flag": "tale_ironspine_1_paid"
                }
              }
            ]
          },
          "next": "tale_paid_1"
        },
        {
          "text": "$i18n:dlg.role.tale.ask",
          "when": {
            "all": [
              {
                "flag": "tale_ironspine_1_paid"
              },
              {
                "not": {
                  "any": [
                    {
                      "quest_active": "base:quest/side/tale_ironspine_2"
                    },
                    {
                      "quest_done": "base:quest/side/tale_ironspine_2"
                    }
                  ]
                }
              }
            ]
          },
          "next": "tale_offer_2"
        },
        {
          "text": "$i18n:dlg.role.tale.status",
          "when": {
            "quest_active": "base:quest/side/tale_ironspine_2"
          },
          "next": "tale_busy_2"
        },
        {
          "text": "$i18n:dlg.role.tale.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/tale_ironspine_2"
              },
              {
                "not": {
                  "flag": "tale_ironspine_2_paid"
                }
              }
            ]
          },
          "next": "tale_paid_2"
        },
        {
          "text": "$i18n:dlg.role.rumor",
          "next": "rumor"
        },
        {
          "text": "$i18n:dlg.role.legend",
          "next": "legend"
        },
        {
          "text": "$i18n:dlg.role.road",
          "next": "road"
        },
        {
          "text": "$i18n:dlg.role.gossip",
          "next": "gossip1"
        },
        {
          "text": "$i18n:dlg.role.season",
          "next": "season_spring_check"
        },
        {
          "text": "$i18n:dlg.role.bye",
          "next": "end"
        }
      ]
    },
    "rumor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.gruff.rumor",
      "next": "end"
    },
    "legend": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.gruff.legend",
      "next": "end"
    },
    "road": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.gruff.road",
      "next": "end"
    },
    "gossip1": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.gossip.gruff.1",
      "next": "gossip2"
    },
    "gossip2": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.gossip.gruff.2",
      "next": "gossip3"
    },
    "gossip3": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.gossip.gruff.3",
      "next": "end"
    },
    "season_spring_check": {
      "type": "condition",
      "when": {
        "season": "spring"
      },
      "then": "season_spring",
      "else": "season_summer_check"
    },
    "season_spring": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.season.gruff.spring",
      "next": "end"
    },
    "season_summer_check": {
      "type": "condition",
      "when": {
        "season": "summer"
      },
      "then": "season_summer",
      "else": "season_autumn_check"
    },
    "season_summer": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.season.gruff.summer",
      "next": "end"
    },
    "season_autumn_check": {
      "type": "condition",
      "when": {
        "season": "autumn"
      },
      "then": "season_autumn",
      "else": "season_winter_check"
    },
    "season_autumn": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.season.gruff.autumn",
      "next": "end"
    },
    "season_winter_check": {
      "type": "condition",
      "when": {
        "season": "winter"
      },
      "then": "season_winter",
      "else": "end"
    },
    "season_winter": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.season.gruff.winter",
      "next": "end"
    },
    "tale_offer_1": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tale.gruff.offer_1",
      "next": "tale_choice_1"
    },
    "tale_choice_1": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.tale.accept",
          "effects": [
            {
              "effect": "start_quest",
              "quest": "base:quest/side/tale_ironspine_1"
            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.tale.later",
          "next": "end"
        }
      ]
    },
    "tale_busy_1": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tale.gruff.busy_1",
      "next": "end"
    },
    "tale_paid_1": {
      "type": "effects",
      "next": "tale_thanks_1",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "tale_ironspine_1_paid",
          "value": true
        },
        {
          "effect": "add_xp",
          "amount": 360
        },
        {
          "effect": "add_gold",
          "amount": 340
        },
        {
          "effect": "add_item",
          "item": "base:item/potion_medium",
          "qty": 1
        }
      ]
    },
    "tale_thanks_1": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tale.gruff.thanks_1",
      "next": "end"
    },
    "tale_offer_2": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tale.gruff.offer_2",
      "next": "tale_choice_2"
    },
    "tale_choice_2": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.tale.accept",
          "effects": [
            {
              "effect": "start_quest",
              "quest": "base:quest/side/tale_ironspine_2"
            }
          ],
          "next": "end"
        },
        {
          "text": "$i18n:dlg.role.tale.later",
          "next": "end"
        }
      ]
    },
    "tale_busy_2": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tale.gruff.busy_2",
      "next": "end"
    },
    "tale_paid_2": {
      "type": "effects",
      "next": "tale_thanks_2",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "tale_ironspine_2_paid",
          "value": true
        },
        {
          "effect": "add_xp",
          "amount": 480
        },
        {
          "effect": "add_gold",
          "amount": 580
        },
        {
          "effect": "add_item",
          "item": "base:item/potion_medium",
          "qty": 2
        }
      ]
    },
    "tale_thanks_2": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tale.gruff.thanks_2",
      "next": "end"
    }
  }
}
