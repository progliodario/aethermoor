      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.friend.ask",
          "next": "friend_offer",
          "when": {
            "all": [
              {
                "renown_at_least": 8
              },
              {
                "not": {
                  "any": [
                    {
                      "quest_active": "base:quest/side/friend_sunscar"
                    },
                    {
                      "quest_done": "base:quest/side/friend_sunscar"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "text": "$i18n:dlg.role.friend.status",
          "when": {
            "quest_active": "base:quest/side/friend_sunscar"
          },
          "next": "friend_busy"
        },
        {
          "text": "$i18n:dlg.role.friend.report",
          "when": {
            "all": [
              {
                "quest_done": "base:quest/side/friend_sunscar"
              },
              {
                "not": {
                  "flag": "friend_sunscar_paid"
                }
              }
            ]
          },
          "next": "friend_paid"
        },
        {
          "text": "$i18n:dlg.role.errand.ask",
