{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/guild_clerk_scholarly",
  "start": "start",
  "nodes": {
    "start": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.guild_clerk.scholarly.hello",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.work",
          "next": "board"
        },
        {
          "text": "$i18n:dlg.role.rumor",
          "next": "rumor"
        },
        {
          "text": "$i18n:dlg.role.bye",
          "next": "end"
        }
      ]
    },
    "board": {
      "type": "effects",
      "effects": [
        {
          "effect": "open_board"
        }
      ],
      "next": "end"
    },
    "rumor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.scholarly.rumor",
      "next": "end"
    }
  }
}
