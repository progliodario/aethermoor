{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/role/shopkeeper_gruff",
  "start": "start",
  "nodes": {
    "start": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.role.shopkeeper.gruff.hello",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.wares",
          "next": "shop"
        },
        {
          "text": "$i18n:dlg.role.craft.ask",
          "when": {
            "not": {
              "flag": "craft_slate_cleaver_done"
            }
          },
          "next": "craft_info"
        },
        {
          "text": "$i18n:dlg.role.rumor",
          "next": "rumor"
        },
        {
          "text": "$i18n:dlg.role.road",
          "next": "road"
        },
        {
          "text": "$i18n:dlg.role.bye",
          "next": "end"
        }
      ]
    },
    "shop": {
      "type": "effects",
      "effects": [
        {
          "effect": "open_shop"
        }
      ],
      "next": "end"
    },
    "rumor": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.gruff.rumor",
      "next": "end"
    },
    "road": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.tone.gruff.road",
      "next": "end"
    },
    "craft_info": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.craft.gruff.info",
      "next": "craft_menu"
    },
    "craft_menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.role.craft.make",
          "when": {
            "all": [
              {
                "has_item": {
                  "item": "base:item/slate_shard",
                  "qty": 14
                }
              },
              {
                "has_item": {
                  "item": "base:item/wolf_fang",
                  "qty": 6
                }
              }
            ]
          },
          "next": "craft_do"
        },
        {
          "text": "$i18n:dlg.role.craft.later",
          "next": "end"
        }
      ]
    },
    "craft_do": {
      "type": "effects",
      "effects": [
        {
          "effect": "remove_item",
          "item": "base:item/slate_shard",
          "qty": 14
        },
        {
          "effect": "remove_item",
          "item": "base:item/wolf_fang",
          "qty": 6
        },
        {
          "effect": "add_item",
          "item": "base:item/slate_cleaver",
          "qty": 1
        },
        {
          "effect": "set_flag",
          "flag": "craft_slate_cleaver_done",
          "value": true
        }
      ],
      "next": "craft_done"
    },
    "craft_done": {
      "type": "say",
      "speaker": "npc",
      "text": "$i18n:dlg.craft.gruff.done",
      "next": "end"
    }
  }
}
