{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/npc/brannoc",
  "start": "c_known",
  "nodes": {
    "c_known": {
      "type": "condition",
      "when": {
        "flag": "brannoc_met"
      },
      "then": "menu",
      "else": "hello"
    },
    "hello": {
      "type": "say",
      "speaker": "wandering_smith_brannoc",
      "text": "$i18n:dlg.brannoc.hello",
      "next": "met"
    },
    "met": {
      "type": "effects",
      "effects": [
        {
          "effect": "set_flag",
          "flag": "brannoc_met",
          "value": true
        }
      ],
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.brannoc.temper",
          "when": {
            "gold_at_least": 40
          },
          "effects": [
            {
              "effect": "temper",
              "gold": 40
            }
          ],
          "next": "done"
        },
        {
          "text": "$i18n:dlg.brannoc.where",
          "next": "d0"
        },
        {
          "text": "$i18n:dlg.brannoc.bye",
          "next": "end"
        }
      ]
    },
    "done": {
      "type": "say",
      "speaker": "wandering_smith_brannoc",
      "text": "$i18n:dlg.brannoc.done",
      "next": "end"
    },
    "d0": {
      "type": "condition",
      "when": {
        "day_mod": {
          "every": 8,
          "at": 0
        }
      },
      "then": "s0",
      "else": "d1"
    },
    "s0": {
      "type": "say",
      "speaker": "wandering_smith_brannoc",
      "text": "$i18n:dlg.brannoc.next_ashen_wastes",
      "next": "end"
    },
    "d1": {
      "type": "condition",
      "when": {
        "day_mod": {
          "every": 8,
          "at": 1
        }
      },
      "then": "s1",
      "else": "d2"
    },
    "s1": {
      "type": "say",
      "speaker": "wandering_smith_brannoc",
      "text": "$i18n:dlg.brannoc.next_lumeria",
      "next": "end"
    },
    "d2": {
      "type": "condition",
      "when": {
        "day_mod": {
          "every": 8,
          "at": 2
        }
      },
      "then": "s2",
