{
  "$schema": "../../../../schemas/dialogue.schema.json",
  "id": "base:dialogue/npc/resident_cormac",
  "start": "c_gift",
  "nodes": {
    "c_gift": {
      "type": "condition",
      "when": {
        "flag": "resident_cormac_gift"
      },
      "then": "talk",
      "else": "hello"
    },
    "hello": {
      "type": "say",
      "speaker": "resident_cormac",
      "text": "$i18n:dlg.resident.cormac.hello",
      "next": "gift"
    },
    "gift": {
      "type": "say",
      "speaker": "resident_cormac",
      "text": "$i18n:dlg.resident.cormac.gift",
      "next": "give"
    },
    "give": {
      "type": "effects",
      "effects": [
        {
          "effect": "add_item",
          "item": "base:item/rune_gale",
          "qty": 1
        },
        {
          "effect": "set_flag",
          "flag": "resident_cormac_gift",
          "value": true
        }
      ],
      "next": "end"
    },
    "talk": {
      "type": "choice",
      "choices": [
        {
          "text": "$i18n:dlg.resident.ask",
          "next": "life"
        },
        {
          "text": "$i18n:dlg.resident.bye",
          "next": "end"
        }
      ]
    },
    "life": {
      "type": "say",
      "speaker": "resident_cormac",
      "text": "$i18n:dlg.resident.cormac.talk",
      "next": "end"
    }
  }
}
